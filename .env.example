# JARVIS – lokale Umgebungsvariablen. Kopieren nach .env (gitignored) und Werte setzen.
# Niemals echte Werte in diese Datei oder ins Repo schreiben (SECURITY.md §7).

# PostgreSQL + pgvector (infra/docker/docker-compose.yml)
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jarvis:change-me@127.0.0.1:5432/jarvis

# Intelligence Provider (ab Phase 3; Secrets später über Credential Broker/Keychain, nicht über .env)
# ANTHROPIC_API_KEY=

# Home Core (Phase 8): JARVIS_HOME=off|fake|homeassistant; Long-Lived Token nur lokal setzen
# JARVIS_HOME=off
# JARVIS_HA_URL=http://homeassistant.local:8123
# JARVIS_HA_TOKEN=
