# JARVIS – lokale Umgebungsvariablen. Kopieren nach .env (gitignored) und Werte setzen.
# Niemals echte Werte in diese Datei oder ins Repo schreiben (SECURITY.md §7).

# PostgreSQL + pgvector (infra/docker/docker-compose.yml)
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jarvis:change-me@127.0.0.1:5432/jarvis

# Intelligence Provider (ab Phase 3; Secrets später über Credential Broker/Keychain, nicht über .env)
# ANTHROPIC_API_KEY=

# Home Core (Phase 8): JARVIS_HOME=off|fake|homeassistant; Long-Lived Token nur lokal setzen
# JARVIS_HOME=off
# JARVIS_HA_URL=http://homeassistant.local:8123
# JARVIS_HA_TOKEN=
# Wake-on-LAN Ziele (JSON-Liste oder Pfad zu JSON): name, mac, host, port, broadcast
# JARVIS_WOL_TARGETS=

# Push (Phase 9): JARVIS_PUSH=off|fake|webhook; URL z. B. https://ntfy.sh/<privates-topic>; Token nur lokal
# JARVIS_PUSH=off
# JARVIS_PUSH_URL=
# JARVIS_PUSH_TOKEN=

# Remote (Phase 9): nur Mesh-VPN-IP oder Loopback hinter `tailscale serve`; 0.0.0.0 wird verweigert
# JARVIS_CORE_HOST=127.0.0.1

# World Intelligence Globe (Phase 10): JARVIS_NEWS=off|fake|rss; Feeds name=url@quality (0..1), kommagetrennt
# JARVIS_NEWS=off
# Proaktivität (Phase 11): Scheduler-Loop im Core-Prozess (Default on), Heimatland für News-Relevanz (ISO-2)
# JARVIS_SCHEDULER=on
# JARVIS_HOME_COUNTRY=DE
# JARVIS_NEWS_FEEDS=tagesschau=https://www.tagesschau.de/xml/rss2/@0.8,bbc=https://feeds.bbci.co.uk/news/world/rss.xml@0.8
